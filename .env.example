# Google Gemini API Key (Get yours from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Primary Gemini Flash model (Defaults to current stable Flash: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Fallback Gemini model on high-demand 503/429 (Defaults to current stable Flash-Lite: gemini-3.5-flash-lite)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: Override Gemini TTS model (Defaults to current stable TTS: gemini-3.8-flash-tts)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Optional: Override Gemini TTS fallback model (Defaults to current stable TTS Lite: gemini-3.8-flash-lite-tts)
# GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
