# Google Gemini API Key (Get yours from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Override Gemini Flash model (Defaults to current stable Flash model: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Override Gemini TTS model (Defaults to current stable TTS model: gemini-3.8-flash-tts)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
